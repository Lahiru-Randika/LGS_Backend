# ==========================================================
# LGS Secure API - Example Environment
# ==========================================================
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# One PostgreSQL connection URL, as requested.
# URL-encode special characters in username/password.
# Example local: postgresql://lgs_app:CHANGE_ME@127.0.0.1:5432/lgs
# Example DigitalOcean: postgresql://doadmin:AVNS_...@db-postgresql-sgp1-XXXXX.b.db.ondigitalocean.com:25060/defaultdb
DATABASE_URL=postgresql://lgs_app:CHANGE_ME@127.0.0.1:5432/lgs
DB_SSL=false
# For DigitalOcean Managed PostgreSQL, enable SSL and provide trusted CA certificate:
# DB_SSL=true
# DB_SSL_CA_PATH=./certs/ca.pem
DB_CONNECTION_LIMIT=10

# Frontend origins allowed to send browser credentials.
# Comma separated.
FRONTEND_ORIGINS=http://localhost:5173
TRUST_PROXY=1

# Opaque server-side sessions. No auth token is stored in localStorage.
SESSION_COOKIE_NAME=lgs_session
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false

# Login protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Uploads - development/local only. Production should use private object storage.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=5

# Fixed external GIS providers. Do not allow clients to supply arbitrary proxy URLs.
VISIGEO_ROOT=https://cmc.visigeo.com
VISIGEO_BUILDINGS_URL=https://cmc.visigeo.com/vector/buildings.geojson
NOMINATIM_ROOT=https://nominatim.openstreetmap.org
OVERPASS_ROOT=https://overpass-api.de/api/interpreter
ENABLE_EXTERNAL_GEOCODING=true

# Initial privileged account. Used only by npm run db:seed.
# Change immediately after first login.
BOOTSTRAP_SUPERIOR_NAME=Initial LGS Superior
BOOTSTRAP_SUPERIOR_EMAIL=superior@lgs.gov.lk
BOOTSTRAP_SUPERIOR_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# In development only, invitation endpoints can return a one-time token
# because no mail provider is configured. MUST be false in production.
EXPOSE_INVITE_TOKEN=true
